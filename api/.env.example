# CareConnect API: the only app that talks to MySQL.
APP_NAME="CareConnect API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=careconnect_db
DB_USERNAME=root
DB_PASSWORD=

# Stateless API: no sessions, file cache, no queue workers needed
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Login tokens expire after this many minutes (1440 = 1 day)
SANCTUM_TOKEN_EXPIRATION=1440

# Platform admin created by "php artisan db:seed" (change these!)
ADMIN_EMAIL=admin@careconnect.com
ADMIN_PASSWORD=admin123
