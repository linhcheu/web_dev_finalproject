# ==========================================================================
# CareConnect API - production .env (Droplet)
#   cp /var/www/careconnect/deploy/env/api.env.example /var/www/careconnect/api/.env
#   micro /var/www/careconnect/api/.env      # replace the CAPITAL placeholders
#   php artisan key:generate
# NEVER commit the real .env - it holds passwords.
# ==========================================================================
APP_NAME="CareConnect API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# The API is the only app with database access
# Mission 4b (one server): DB_HOST=127.0.0.1
# Mission 5A (app server + DB server): DB_HOST=<DB server IP>, and on the DB server
#   CREATE USER 'careconnect'@'<APP server IP>' + GRANT, ufw allow 3306 from the APP server IP
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=careconnect_db
DB_USERNAME=YOUR_MYSQL_USER
DB_PASSWORD="YOUR_MYSQL_PASSWORD"

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Login tokens expire after this many minutes (1440 = 1 day)
SANCTUM_TOKEN_EXPIRATION=1440

# Platform admin created by "php artisan db:seed" - choose your own!
ADMIN_EMAIL=admin@careconnect.com
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
