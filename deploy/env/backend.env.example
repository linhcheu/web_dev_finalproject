# ==========================================================================
# CareConnect admin panel (port 8080) - production .env for the DigitalOcean Droplet
#
# On the server:
#   cp /var/www/careconnect/deploy/env/backend.env.example /var/www/careconnect/backend/.env
#   micro /var/www/careconnect/backend/.env      # replace every CAPITAL placeholder
#   php artisan key:generate                  # fills APP_KEY
#
# NEVER commit the real .env to GitHub - it holds your password.
# ==========================================================================

APP_NAME="CareConnect Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=true              # true while testing, set to false when everything works
APP_URL=http://YOUR_SERVER_IP:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL (same database for BOTH apps: website + admin panel) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=careconnect_db
DB_USERNAME=YOUR_MYSQL_USER
DB_PASSWORD="YOUR_MYSQL_PASSWORD"   # keep the quotes (a # in the password would cut it off)

# --- Sessions ---
# file = no extra table needed. Each app has its OWN cookie name: browsers
# share cookies between ports of the same IP, so two apps using the default
# "laravel_session" would log each other out (419 Page Expired).
SESSION_DRIVER=file
SESSION_COOKIE=careconnect_admin_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The project has no cache/jobs tables, so don't use the "database" drivers
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# DigitalOcean blocks outgoing SMTP on new accounts -> write mails to the log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@careconnect.local"
MAIL_FROM_NAME="${APP_NAME}"
