# ==========================================================================
# CareConnect website (port 80) - production .env (Droplet)
#   cp /var/www/careconnect/deploy/env/frontend.env.example /var/www/careconnect/frontend/.env
#   micro /var/www/careconnect/frontend/.env      # replace YOUR_SERVER_IP
#   php artisan key:generate
# This app has NO database: all data comes from the API.
# ==========================================================================
APP_NAME="CareConnect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# The API runs on the same server, only reachable locally
API_URL=http://127.0.0.1:8081
# Uploaded pictures: served by this site's Apache vhost (Alias /storage)
API_MEDIA_URL=http://YOUR_SERVER_IP/storage

# Each app needs its OWN cookie name: browsers share cookies between
# ports of the same IP, so equal names would log each other out (419).
SESSION_DRIVER=file
SESSION_COOKIE=careconnect_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
