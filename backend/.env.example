# CareConnect admin panel (platform admins). No database: all data comes from the API.
APP_NAME="CareConnect Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Where the CareConnect API (api/ app) runs, and where its uploaded pictures are served
API_URL=http://127.0.0.1:8081
API_MEDIA_URL=http://127.0.0.1:8081/storage

# Sessions are files on disk. Each app needs its OWN cookie name because browsers
# share cookies between ports of the same host.
SESSION_DRIVER=file
SESSION_COOKIE=careconnect_admin_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
